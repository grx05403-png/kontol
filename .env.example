# Frontend hanya memakai publishable/anon key Supabase.
# Publishable key memang boleh berada di browser bila seluruh tabel terlindungi RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SEMUA nilai di bawah ini adalah secret server-side.
# Jangan beri prefix VITE_ dan jangan pernah commit nilai aslinya ke Git.
# Masukkan melalui Supabase Dashboard > Edge Functions > Secrets atau CLI.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEYS=
SUPABASE_SECRET_KEYS=
BOOTSTRAP_ADMIN_SECRET=
APP_ORIGIN=https://domain-website-kamu.example
AI_PROVIDER_API_KEY=
AI_MODEL=
AI_API_BASE_URL=

  "version": "0.2.9",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run verify-lock && npm run typecheck && npm run build",
    "audit": "npm audit --audit-level=high",
    "verify-lock": "node scripts/verify-lockfile.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "gsap": "3.15.1",
    "jspdf": "4.2.1",
    "lenis": "1.3.27",
    "lucide-react": "0.468.0",
    "motion": "12.23.24",
    "pdfjs-dist": "5.4.149",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "5.9.2",
    "vite": "7.3.8",
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "core-js": false,
    "tesseract.js": false
